{
  "name": "normify-codex",
  "version": "0.6.0",
  "description": "Codex 原生架构治理：31 个本地 MCP 工具、架构生成与伴随开发技能、一键安装。",
  "type": "module",
  "main": "./lib/tools.js",
  "types": "./lib/types/tools.d.ts",
  "bin": {
    "normify-mcp": "./src/stdio.mjs",
    "normify-install": "./scripts/install-codex.mjs"
  },
  "files": [
    "lib",
    "src/*.mjs",
    "scripts/*.mjs",
    "skills",
    "vendor",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "yan-mc",
  "keywords": [
    "codex",
    "mcp",
    "agent-skill",
    "architecture",
    "structure-diagram",
    "module-tree",
    "normify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaraAlu/dsh-normify.git"
  },
  "bugs": {
    "url": "https://github.com/RaraAlu/dsh-normify/issues"
  },
  "homepage": "https://github.com/RaraAlu/dsh-normify#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node src/stdio.mjs",
    "check": "node scripts/check.mjs && node ci-contract-check.cjs",
    "test": "npm run test:codex && npm run test:engine",
    "test:codex": "node --test tests/*.test.mjs",
    "test:engine": "node tests/engine-e2e.mjs && node tests/companion-e2e.mjs && node tests/regression-0.5.2.mjs && node tests/regression-0.5.3.mjs && node tests/regression-0.5.4.mjs",
    "setup": "node scripts/setup.mjs",
    "install:codex": "node scripts/install-codex.mjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "install:hooks": "node scripts/install-hooks.mjs"
  }
}
